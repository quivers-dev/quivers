{"stan":["  int<lower=1> K_muB;  // number of population-level effects","  matrix[N, K_muB] X_muB;  // population-level design matrix","  int<lower=1> Kc_muB;  // number of population-level effects after centering","  int<lower=1> K_muC;  // number of population-level effects","  matrix[N, K_muC] X_muC;  // population-level design matrix","  int<lower=1> Kc_muC;  // number of population-level effects after centering","  matrix[N, Kc_muB] Xc_muB;  // centered version of X_muB without an intercept","  vector[Kc_muB] means_X_muB;  // column means of X_muB before centering","  matrix[N, Kc_muC] Xc_muC;  // centered version of X_muC without an intercept","  vector[Kc_muC] means_X_muC;  // column means of X_muC before centering","  for (i in 2:K_muB) {","    means_X_muB[i - 1] = mean(X_muB[, i]);","    Xc_muB[, i - 1] = X_muB[, i] - means_X_muB[i - 1];","  for (i in 2:K_muC) {","    means_X_muC[i - 1] = mean(X_muC[, i]);","    Xc_muC[, i - 1] = X_muC[, i] - means_X_muC[i - 1];","  vector[Kc_muB] b_muB;  // regression coefficients","  real Intercept_muB;  // temporary intercept for centered predictors","  vector[Kc_muC] b_muC;  // regression coefficients","  real Intercept_muC;  // temporary intercept for centered predictors","  lprior += student_t_lpdf(Intercept_muB | 3, 0, 2.5);","  lprior += student_t_lpdf(Intercept_muC | 3, 0, 2.5);","    vector[N] muB = rep_vector(0.0, N);","    vector[N] muC = rep_vector(0.0, N);","    muB += Intercept_muB + Xc_muB * b_muB;","    muC += Intercept_muC + Xc_muC * b_muC;","      mu[n] = transpose([0, muB[n], muC[n]]);","      target += categorical_logit_lpmf(Y[n] | mu[n]);","  real b_muB_Intercept = Intercept_muB - dot_product(means_X_muB, b_muB);","  real b_muC_Intercept = Intercept_muC - dot_product(means_X_muC, b_muC);"],"refcat_stan":["  int<lower=1> K_muA;  // number of population-level effects","  matrix[N, K_muA] X_muA;  // population-level design matrix","  int<lower=1> Kc_muA;  // number of population-level effects after center