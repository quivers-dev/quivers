{"ordered_stan":["  simplex[2] theta;  // mixing proportions","  ordered[2] ordered_Intercept;  // to identify mixtures","  real Intercept_mu1 = ordered_Intercept[1];","  real Intercept_mu2 = ordered_Intercept[2];","  lprior += student_t_lpdf(Intercept_mu1 | 3, 0.3, 2.5);","  lprior += student_t_lpdf(Intercept_mu2 | 3, 0.3, 2.5);","  lprior += dirichlet_lpdf(theta | con_theta);","    mu1 += Intercept_mu1 + Xc_mu1 * b_mu1;","    mu2 += Intercept_mu2 + Xc_mu2 * b_mu2;","      ps[1] = log(theta1) + normal_lpdf(Y[n] | mu1[n], sigma1);","      ps[2] = log(theta2) + normal_lpdf(Y[n] | mu2[n], sigma2);","      target += log_sum_exp(ps);","  real b_mu1_Intercept = Intercept_mu1 - dot_product(means_X_mu1, b_mu1);","  real b_mu2_Intercept = Intercept_mu2 - dot_product(means_X_mu2, b_mu2);"],"predicted_stan":["  int<lower=1> K_theta2;  // number of population-level effects","  matrix[N, K_theta2] X_theta2;  // population-level design matrix","  int<lower=1> Kc_theta2;  // number of population-level effects after centering","  matrix[N, Kc_theta2] Xc_theta2;  // centered version of X_theta2 without an intercept","  vector[Kc_theta2] means_X_theta2;  // column means of X_theta2 before centering","  for (i in 2:K_theta2) {","    means_X_theta2[i - 1] = mean(X_theta2[, i]);","    Xc_theta2[, i - 1] = X_theta2[, i] - means_X_theta2[i - 1];","  vector[Kc_theta2] b_theta2;  // regression coefficients","  real Intercept_theta2;  // temporary intercept for centered predictors","  lprior += logistic_lpdf(Intercept_theta2 | 0, 1);","    vector[N] theta2 = rep_vector(0.0, N);","    vector[N] theta1 = rep_vector(0.0, N);","    real log_sum_exp_theta;","    theta2 += Intercept_theta2 + Xc_theta2 * b_theta2;","      // scale theta to become a probability vector","      log_sum_exp_theta = log(exp(theta1[n]) + exp(theta2[n]));","      theta1[n] = theta1[n] - log_sum_exp_theta;","      theta2[n] = theta2[n] - log_sum_exp_theta;","      ps[1] = theta1[n] + normal_lpdf(Y[n] | mu1[n], sigma1);","