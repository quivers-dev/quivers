# A multivariate normal whose mean is host data: the unplated draw takes
# its event size from the program's codomain, and the datum is that size.
object Dim : Real 2
object One : FinSet 1
program mvn_host_loc : One -> Dim
    sample mu <- MultivariateNormal(loc=m0, scale_tril=[[1.0, 0.0], [0.5, 1.0]])
    observe y <- MultivariateNormal(loc=mu, scale_tril=[[1.5, 0.0], [-0.3, 0.8]])
    return mu
export mvn_host_loc
