# A covariance built in the program: an LKJ correlation factor scaled by
# per-coordinate standard deviations, the Cholesky factor of a plated
# multivariate normal observation.
object Dk : FinSet 3
object Row : FinSet 4
object One : FinSet 1
program mvn_lkj_factor : One -> One
    sample L : Dk <- LKJCholesky(concentration=2.0)
    sample sigma : Dk <- HalfNormal(scale=1.0)
    sample mu : Dk <- Normal(loc=0.0, scale=1.0)
    let Ls = factor i : Dk, j : Dk in sigma[i] * L[i, j]
    observe y : Row <- MultivariateNormal(loc=mu, scale_tril=Ls) [over=Dk]
    return mu
export mvn_lkj_factor
