# A Bernoulli observation written with logits, the log-odds a sampled
# linear predictor gives.
object Row : FinSet 4
object One : FinSet 1
program bernoulli_logits : One -> One
    sample eta <- Normal(loc=0.0, scale=2.0)
    observe y : Row <- Bernoulli(logits=eta)
    return eta
export bernoulli_logits
