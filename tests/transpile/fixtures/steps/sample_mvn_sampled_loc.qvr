# A multivariate normal whose mean is a sampled vector and whose
# covariance is written as a non-identity Cholesky factor.
object Dim : FinSet 2
object One : FinSet 1
program mvn_sampled_loc : One -> One
    sample m <- Normal(loc=0.0, scale=1.0) [over=Dim]
    sample v <- MultivariateNormal(loc=m, scale_tril=[[1.0, 0.0], [0.5, 1.0]]) [over=Dim]
    return v
export mvn_sampled_loc
