# A matrix normal over 2 x 3 matrices with distinct row and column
# covariances.
object Rows : FinSet 2
object Cols : FinSet 3
object One : FinSet 1
program matrix_normal : One -> One
    sample m <- MatrixNormal(loc=[[0.0, 1.0, 0.0], [0.5, 0.0, -0.5]], row_covariance=[[1.0, 0.3], [0.3, 2.0]], col_covariance=[[1.0, 0.2, 0.0], [0.2, 1.5, 0.1], [0.0, 0.1, 0.7]]) [over=[Rows, Cols]]
    return m
export matrix_normal
