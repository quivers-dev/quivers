# A zero-inflated Poisson whose active weight is given on the logit
# scale: each row's gate is marginalized over {0, 1} with weights
# log sigmoid(-eta_row) and log sigmoid(eta_row), computed in log space;
# the active component is Poisson(r) at a per-row rate r.
object Row : FinSet 4
object One : FinSet 1
program zip_logits : Row -> One
    sample eta <- Normal(loc=0.0, scale=10.0)
    let eta_row = eta + x
    marginalize z : Row <- ContinuousBernoulli(logits=eta_row)
        let gated_rate = z * r
        observe y : Row <- Poisson(rate=gated_rate)
    return eta
export zip_logits
