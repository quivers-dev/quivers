# Exercises a list literal combined elementwise with a plated value in a
# plated `let`: each row reads the literal's own entry.
object Step : FinSet 4
object Val : Real 1

program p : Step -> Val
    sample mu <- Normal(loc=0.0, scale=1.0)
    let ys = [1.0, 2.0, 3.0, 4.0]
    let total = ys * mu + [2.5, 0.5, 3.5, 1.0]
    let scaled = mu * [1.0, 2.0, 3.0, 4.0]
    observe y : Step <- Normal(loc=scaled, scale=1.0)
    score s = sum(total * total)
    return mu

export p
