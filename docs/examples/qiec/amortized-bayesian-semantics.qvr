# Bayesian Semantics Case Study
#
# One checked module holding four computational views of a reading
# experiment:
#
#   1. a learnable categorial grammar sums over sentence derivations
#      with forward and backward application and harmonic forward
#      composition (X/Y, Y/Z |- X/Z), so word order matters;
#   2. a structural autoencoder learns continuous logical-form codes
#      under its own reconstruction loss; no other entry reads them;
#   3. an indexed computation separates observed and missing
#      measurements under a 95/5 Normal/Student-t contamination measure;
#   4. a hierarchical reading-time program places a prior on the
#      intercept through an authored scale handler, pools participant
#      and item effects, and marginalizes an item-level analysis exactly.

object Atoms : {N, NP, S}
object Cat : FreeResiduated(Atoms)
object Token : {every, some, linguist, model, predicts, surprises}

schema fwd_app (X, Y : Cat) : (X / Y) * Y -> X
schema bwd_app (X, Y : Cat) : Y * (X \ Y) -> X
schema fwd_comp (X, Y, Z : Cat) : (X / Y) * (Y / Z) -> X / Z

bundle semantic_rules : [fwd_app, bwd_app, fwd_comp]

define semantic_parser = parser(rules=[semantic_rules], terminal=Token, start=S, depth=1)

signature Semantics
    sorts
        Formula : object
        Entity  : data [dim=32, vocab=["linguist", "model"]]
        Pred    : data [dim=32, vocab=["predict", "surprise"]]
    constructors
        Name  : Entity -> Formula
        Apply : Pred, Formula -> Formula
        And   : Formula, Formula -> Formula
    binders
        Exists : binds (x : Formula) in (body : Formula) -> Formula

encoder Enc : Semantics
    dim Formula = 32
    op Apply(pred, arg) |-> tanh(pred + arg)
    op And(left, right) |-> tanh(left + right)

decoder Dec : Semantics [depth=7]
    dim Formula = 32
    body |-> recursive

loss reconstruct [weight=0.25, on=decoder(Dec)]
    -Dec.log_prob(term, Enc(term))

index Availability = Observed | Missing

family Measurement(s : Availability) : Type
    constructor Present : Real -> Measurement(Observed)
    constructor Absent : Measurement(Missing)

instance random : Random
instance score : Score

define contamination(location : Real, scale : Real) : Sampleable[Real] !{} =
    return Mixture([0.95, 0.05], [Normal(location, scale), StudentT(3.0, location, scale)])

define complete[s : Availability](measurement : Measurement(s), location : Real, scale : Real) : Real !{random, score} =
    let likelihood <- contamination(location, scale)
    case measurement motive (t : Availability) => Real
        Present(value) =>
            perform score.add(log_prob(likelihood, value))
            return value
        Absent =>
            let value <- perform random.sample[Real](site("held_out_reading_time"), likelihood)
            return value

# The intercept is drawn on a standardized scale; the request
# ``locate`` asks the active handler to place it on the measurement
# scale. ``log_milliseconds`` answers with 6.0 + 0.5 * z, which makes
# the intercept Normal(6.0, 0.5) on the log-millisecond scale: a prior
# centred near exp(6.0), about 403 ms. Swapping the handler changes
# the measurement scale without touching the model that requests it.
effect Scale
    locate : Real -> Real

instance scale : Scale

handler log_milliseconds for Scale : Real -> Real [coverage=total, forwards=none, implementation=authored]
    return x =>
        return x
    locate(z : Real) resumes 1 =>
        resume(6.0 + 0.5 * z)

define locate_intercept(z : Real) : Real !{} =
    handle scale with log_milliseconds in
        let located <- perform scale.locate(z)
        return located

composition log_prob [level=algebra]

object Participant : FinSet 40
object Item : FinSet 64
object Trial : FinSet 640
object Analysis : FinSet 2
object ReadingTime : Real 1

program reading_times(concentration : Real) : Trial -> ReadingTime
    let chart = parse(semantic_parser, sentence)
    score syntactic_evidence = chart.goal_weight()

    sample participant_scale <- HalfStudentT(df=3.0, scale=0.5)
    sample item_scale <- HalfStudentT(df=3.0, scale=0.5)
    sample residual_scale <- HalfStudentT(df=4.0, scale=0.25)

    sample participant_raw : Participant <- Normal(loc=0.0, scale=1.0)
    sample item_raw : Item <- Normal(loc=0.0, scale=1.0)
    sample analysis_shift : Analysis <- Normal(loc=0.0, scale=0.5)
    sample analysis_prob : Item <- Dirichlet(concentration=concentration) [over=Analysis, iid_over=Item]

    let participant_effect = participant_scale * participant_raw[participant_idx]
    let item_effect = item_scale * item_raw[item_idx]
    sample intercept_raw <- Normal(loc=0.0, scale=1.0)
    let intercept <- locate_intercept(intercept_raw)
    let mean_log_rt = intercept + participant_effect + item_effect

    observe log_rt : Trial <- Normal(loc=mean_log_rt, scale=residual_scale)

    marginalize analysis : Analysis <- Categorical(probs=analysis_prob) [over=Item, reduction=logsumexp]
        observe ambiguity_rating : Trial <- Normal(loc=analysis_shift[analysis], scale=residual_scale) [via=item_idx]

    let held_out <- complete[Missing](construct Absent() as Measurement(Missing), intercept, residual_scale)
    return held_out

export semantic_parser
export reading_times
