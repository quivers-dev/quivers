{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "QVR",
  "scopeName": "source.qvr",
  "fileTypes": [
    "qvr"
  ],
  "patterns": [
    {
      "include": "#comment-doc"
    },
    {
      "include": "#pragma"
    },
    {
      "include": "#block-comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keyword-control"
    },
    {
      "include": "#keyword-declaration"
    },
    {
      "include": "#keyword-qiec-modifier"
    },
    {
      "include": "#keyword-composition-level"
    },
    {
      "include": "#keyword-structural"
    },
    {
      "include": "#keyword-deduction"
    },
    {
      "include": "#keyword-parser"
    },
    {
      "include": "#keyword-operator"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#semiring"
    },
    {
      "include": "#algebra"
    },
    {
      "include": "#distribution-family"
    },
    {
      "include": "#qiec-option-value"
    },
    {
      "include": "#qiec-literal"
    },
    {
      "include": "#numeric-literal"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment-doc": {
      "name": "comment.block.documentation.qvr",
      "match": "#!\\s.*$"
    },
    "pragma": {
      "name": "meta.attribute.qvr",
      "begin": "#!?\\[",
      "end": "\\]",
      "patterns": [
        { "include": "#string" },
        { "include": "#numeric-literal" },
        {
          "name": "entity.name.tag.qvr",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.qvr",
      "match": "#(?![!\\[{]).*$"
    },
    "block-comment": {
      "name": "comment.block.qvr",
      "begin": "#\\{",
      "end": "\\}#"
    },
    "string": {
      "name": "string.quoted.double.qvr",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.qvr",
          "match": "\\\\."
        }
      ]
    },
    "keyword-control": {
      "name": "keyword.control.qvr",
      "match": "\\b(sample|observe|marginalize|score|return|let|where|in|from|as|export|perform|handle|case|motive|resumes|resume|lacks|construct|for|with|if|then|else|not)\\b"
    },
    "keyword-declaration": {
      "name": "keyword.declaration.qvr",
      "match": "\\b(composition|contraction|category|object|morphism|schema|rule|bundle|program|deduction|signature|encoder|decoder|loss|define|index|family|constructor|effect|instance|handler)\\b"
    },
    "keyword-qiec-modifier": {
      "comment": "QIEC kinds, handler coverage, forwarding, and resumption grades.",
      "name": "storage.modifier.qvr",
      "match": "\\b(Type|Effect|Row|Shape|Context|total|partial|aff|omega|coverage|forwards|introduces|implementation|authored|foreign)\\b"
    },
    "keyword-composition-level": {
      "comment": "Composition-level names carried by `[level=...]` option values.",
      "name": "storage.modifier.qvr",
      "match": "\\b(algebra|semigroupoid|bilinear_form)\\b"
    },
    "keyword-structural": {
      "name": "keyword.declaration.structural.qvr",
      "match": "\\b(sorts|constructors|binders|vertex_kinds|edge_kinds|binds|dim|iterations|readout|op|init|message|update|var_init|recurrent|attention|structure|primitive|factor|binder_select|body|recursive|data|index)\\b"
    },
    "keyword-deduction": {
      "name": "keyword.declaration.deduction.qvr",
      "match": "\\b(atoms|lexicon)\\b"
    },
    "keyword-parser": {
      "name": "keyword.other.parser.qvr",
      "match": "\\b(rules|categories|terminal|start|depth|effect_depth|lex|binary|unary|ops|max_length)\\b"
    },
    "keyword-operator": {
      "patterns": [
        {
          "comment": "Encoder / decoder body arrow (must be matched before bitwise `|`).",
          "name": "keyword.operator.body-arrow.qvr",
          "match": "\\|->"
        },
        {
          "comment": "Sequent arrow used in deduction rules.",
          "name": "keyword.operator.sequent.qvr",
          "match": "\\|-|⊢"
        },
        {
          "comment": "Compose arrows (longest-first; trans-compose first).",
          "name": "keyword.operator.qvr",
          "match": ">>>|>>|<<|->|<-"
        },
        {
          "comment": "Graph undirected-edge arrow (matched before unary minus).",
          "name": "keyword.operator.edge.qvr",
          "match": "--"
        },
        {
          "name": "keyword.operator.qvr",
          "match": "~"
        },
        {
          "name": "keyword.operator.qvr",
          "match": "@"
        }
      ]
    },
    "builtin-function": {
      "name": "support.function.builtin.qvr",
      "match": "\\b(identity|cup|cap|fan|repeat|stack|scan|parser|ccg|lambek|chart_fold|from_data|freeze|dagger|trace|change_base|curry_left|curry_right|FreeResiduated|FreeMonoid|abs|acos|acosh|asin|asinh|atan|atanh|ceil|concat|cos|cosh|cumsum|digamma|elu|erf|erfc|erfinv|exp|expm1|filter|floor|fold|gelu|int|length|lgamma|log|log10|log1p|log2|log_softmax|logsigmoid|logsumexp|logsumexp_over|map|max|mean|min|mish|normalize|pow|prod|real|reciprocal|relu|relu6|round|rsqrt|select|selu|sigmoid|sign|silu|sin|sinh|slice|softmax|softplus|softsign|sort|sqrt|square|sum|tan|tanh|traverse|trunc|weight|weight_value)\\b"
    },
    "builtin-type": {
      "name": "support.class.builtin.qvr",
      "match": "\\b(FinSet|Real|Simplex|Sphere|Ball|CholeskyFactor|Covariance|Correlation|Orthogonal|Stiefel|LowerTriangular|Diagonal|Mor|Space|Object|Nat|Unit|Bool|Int|String)\\b"
    },
    "semiring": {
      "comment": "Semiring names carried by `[semiring=...]` option values.",
      "name": "support.constant.semiring.qvr",
      "match": "\\b(LogProb|Boolean|Viterbi|Counting|ProductFuzzyAlgebra)\\b"
    },
    "algebra": {
      "comment": "Built-in algebra names.",
      "name": "support.constant.algebra.qvr",
      "match": "\\b(product_fuzzy|boolean|lukasiewicz|godel|tropical|max_plus|log_prob|markov|real|probability|counting|material_impl|reichenbach|boolean_dual|dual_lukasiewicz|dual_godel)\\b"
    },
    "distribution-family": {
      "name": "support.type.distribution.qvr",
      "match": "\\b(Bernoulli|Beta|BetaBinomial|Binomial|Categorical|Cauchy|Chi2|ContinuousBernoulli|Dirichlet|Exponential|FisherSnedecor|GP|Gamma|GeneralizedPareto|Geometric|Gumbel|HalfCauchy|HalfNormal|HalfStudentT|Horseshoe|HurdlePoisson|Independent|InverseGamma|InverseWishart|Kumaraswamy|LKJCholesky|LKJCorrelationFactor|Laplace|LogNormal|Logistic|LogisticNormal|LogitNormal|LowRankMVN|MatrixNormal|Mixture|MixtureNormal|MultivariateNormal|NegativeBinomial|Normal|Normalize|OneHotCategorical|OrderedLogistic|OrderedProbit|Pareto|PointMass|Poisson|Pushforward|RelaxedBernoulli|RelaxedOneHotCategorical|Restrict|StudentT|Transformed|Truncate|Truncated|TruncatedNormal|Uniform|VonMises|Weibull|Wishart|ZeroInflatedPoisson|ZeroOneInflatedBeta)\\b"
    },
    "qiec-option-value": {
      "comment": "QIEC handler-forwarding option values.",
      "name": "constant.language.qvr",
      "match": "\\b(unknown|none)\\b"
    },
    "qiec-literal": {
      "name": "constant.language.qvr",
      "match": "\\b(true|false|unit)\\b"
    },
    "numeric-literal": {
      "patterns": [
        {
          "comment": "Floats admit trailing-dot, leading-dot, and exponent-only forms, optionally signed.",
          "name": "constant.numeric.float.qvr",
          "match": "(?<![\\w.])-?(?:\\d+\\.\\d*(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)(?![\\w.])"
        },
        {
          "name": "constant.numeric.integer.qvr",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.qvr",
          "match": "[()\\[\\]{},;]"
        },
        {
          "name": "punctuation.separator.qvr",
          "match": ":"
        },
        {
          "name": "keyword.operator.assignment.qvr",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.qvr",
          "match": "[+*/\\\\]"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "comment": "PascalCase / UPPER-leading identifiers colour as types.",
          "name": "entity.name.type.qvr",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "comment": "Snake-case / lowercase-leading identifiers colour as variables.",
          "name": "variable.other.qvr",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
