{
  "name": "vscode-qvr",
  "displayName": "QVR Language Support",
  "description": "Syntax highlighting and LSP support for the Quivers QVR probabilistic programming language",
  "version": "0.7.1",
  "publisher": "quivers",
  "repository": {
    "type": "git",
    "url": "https://github.com/quivers-dev/quivers"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:qvr"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qvr",
        "aliases": [
          "QVR",
          "qvr"
        ],
        "extensions": [
          ".qvr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qvr",
        "scopeName": "source.qvr",
        "path": "./syntaxes/qvr.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "QVR",
      "properties": {
        "qvr.lsp.path": {
          "type": "string",
          "default": "qvr-lsp",
          "description": "Path to the qvr-lsp executable (falls back to `qvr lsp` if unset)."
        },
        "qvr.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the QVR language server."
        },
        "qvr.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the qvr-lsp executable."
        },
        "qvr.transpileTarget": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "bugs",
            "church",
            "edward2",
            "gen",
            "jags",
            "numpyro",
            "pymc",
            "pyro",
            "stan",
            "turing",
            "webppl"
          ],
          "description": "Selected transpile target for live QIEC capability diagnostics."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --out vscode-qvr-${npm_package_version}.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.2.0"
  }
}
