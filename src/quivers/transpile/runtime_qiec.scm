             (x (- value 1.0))
             (total (let loop ((items coefficients) (i 1) (acc 0.99999999999980993))
                      (if (null? items) acc (loop (cdr items) (+ i 1) (+ acc (/ (car items) (+ x i)))))))
             (t (+ x 7.5)))
        (+ (* 0.5 (log (* 2.0 3.141592653589793))) (* (+ x 0.5) (log t)) (- t) (log total)))))
