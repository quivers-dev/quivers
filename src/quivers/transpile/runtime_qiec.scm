(define (_qvr-qiec-sigmoid value)
  (if (>= value 0.0)
      (/ 1.0 (+ 1.0 (exp (- value))))
      (let ((e (exp value))) (/ e (+ 1.0 e)))))
(define (_qvr-qiec-softplus value)
  (+ (max value 0.0) (log (+ 1.0 (exp (- (abs value)))))))
;; The error function by its Taylor series near the origin and by the
;; continued fraction of the complementary function in the tails.
(define (_qvr-qiec-erf value)
