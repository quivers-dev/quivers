(define (_qvr-qiec-transport evidence value target-type static-environment)
  (_qvr-qiec-specialize evidence static-environment)
  (_qvr-qiec-specialize target-type static-environment)
  value)
(define (_qvr-qiec-attachment attachments attachment expected-type static-environment)
