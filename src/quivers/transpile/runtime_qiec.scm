;; A tensor reaches a primitive either as its tuple record or, once read
;; through a binding, as the record's item list; neither is an
;; association list, which is how a constructor or evidence record looks.
(define (_qvr-qiec-tensor? value)
  (and (pair? value)
       (or (equal? (_qvr-qiec-get value "qiec" #f) "tuple")
           (not (_qvr-qiec-alist? value)))))
(define (_qvr-qiec-items value)
  (if (and (pair? value) (equal? (_qvr-qiec-get value "qiec" #f) "tuple"))
      (_qvr-qiec-get value "items" '())
      value))
(define (_qvr-qiec-broadcast implementation arguments)
  (let ((tensors (filter _qvr-qiec-tensor? arguments)))
    (if (null? tensors)
        (apply implementation arguments)
        (let ((len (length (_qvr-qiec-items (car tensors)))))
          (if (not (for-all (lambda (tensor) (= (length (_qvr-qiec-items tensor)) len)) tensors))
              (error 'qiec "QIEC primitive applied to tensors of differing shapes"))
          (_qvr-qiec-tuple
            (let loop ((index 0))
              (if (= index len)
                  '()
                  (cons (_qvr-qiec-broadcast implementation
                                             (map (lambda (argument)
                                                    (if (_qvr-qiec-tensor? argument)
                                                        (list-ref (_qvr-qiec-items argument) index)
                                                        argument))
                                                  arguments))
                        (loop (+ index 1))))))))))
(define (_qvr-qiec-primitive name arguments)
  (let ((entry (assoc name _qvr-qiec-primitives)))
    (if (not entry) (error 'qiec "unknown QIEC primitive" name))
    (_qvr-qiec-broadcast (cdr entry) (map _qvr-qiec-raw arguments))))
(define (_qvr-qiec-raw value)
  (if (_qvr-qiec-binding? value) (vector-ref (_qvr-qiec-get value "cell") 0) value))
(define (_qvr-qiec-gather value index)
  (let ((items (_qvr-qiec-value value)) (index (_qvr-qiec-value index)))
    (if (not (list? items)) (error 'qiec "QIEC gather from a non-tensor runtime value"))
    (if (list? index)
        (_qvr-qiec-tuple (map (lambda (item) (_qvr-qiec-gather value item)) index))
        (list-ref items index))))
(define (_qvr-qiec-flat value)
  (let ((value (_qvr-qiec-value value)))
    (if (list? value)
        (apply append (map _qvr-qiec-flat value))
        (list value))))
(define (_qvr-qiec-reduce operator value)
  (let* ((entries (_qvr-qiec-flat value)) (total (apply + entries)))
    (cond
      ((string=? operator "sum") total)
      ((string=? operator "mean") (/ total (length entries)))
      ((string=? operator "max") (apply max entries))
      ((string=? operator "min") (apply min entries))
      ((string=? operator "prod") (apply * entries))
      (else (let ((peak (apply max entries)))
              (+ peak (log (apply + (map (lambda (entry) (exp (- entry peak))) entries)))))))))
