    (if (< x 2.5)
        (let loop ((term x) (total x) (n 0))
          (if (or (<= (abs term) (* 1e-17 (abs total))) (>= n 200))
              (* sign (/ 2.0 (sqrt 3.141592653589793)) total)
              (let* ((n2 (+ n 1)) (term2 (* term (/ (- (* x x)) n2))))
                (loop term2 (+ total (/ term2 (+ (* 2 n2) 1))) n2))))
        (let loop ((k 60) (fraction x))
          (if (= k 0)
              (* sign (- 1.0 (/ (exp (- (* x x))) (sqrt 3.141592653589793) fraction)))
              (loop (- k 1) (+ x (/ (/ k 2.0) fraction))))))))
(define (_qvr-qiec-erfinv value)
