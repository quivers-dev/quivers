    ((or (< value -1.0) (> value 1.0)) (error 'qiec "erfinv is defined on [-1, 1]"))
    ((= value 1.0) +inf.0)
    ((= value -1.0) -inf.0)
    ((= value 0.0) 0.0)
    (else
     (let* ((sign (if (> value 0.0) 1.0 -1.0))
            (magnitude (abs value))
            (estimate
             (if (< magnitude 0.7)
                 (let ((square (* magnitude magnitude)))
                   (/ (* magnitude (+ (* (- (* (+ (* -0.140543331 square) 0.914624893) square) 1.645349621) square) 0.886226899))
                      (+ (* (+ (* (- (* (+ (* 0.012229801 square) -0.329097515) square) -1.442710462) square) -2.118377725) square) 1.0)))
                 (let ((tail (sqrt (- (log (/ (- 1.0 magnitude) 2.0))))))
                   (/ (- (* (- (* (+ (* 1.641345311 tail) 3.429567803) tail) 1.62490649) tail) 1.970840454)
                      (+ (* (+ (* 1.637067800 tail) 3.543889200) tail) 1.0))))))
       (let loop ((i 0) (estimate estimate))
         (if (= i 3)
             (* sign estimate)
             (loop (+ i 1)
                   (- estimate (/ (- (_qvr-qiec-erf estimate) magnitude)
                                  (* (/ 2.0 (sqrt 3.141592653589793)) (exp (- (* estimate estimate)))))))))))))
;; Lanczos approximation of log gamma.
(define (_qvr-qiec-lgamma value)
