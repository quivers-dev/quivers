(define (_qvr-qiec-as-computation value)
  (if (and (pair? value) (memq (car value) '(pure effect call bind)))
      value
      (_qvr-qiec-pure value)))
(define (_qvr-qiec-validate validator value label)
  (if (not validator)
      value
      (if (eq? (validator (_qvr-qiec-value value)) #f)
          (error 'qiec "QIEC runtime value failed" label)
          value)))
(define (_qvr-qiec-validate-computation computation validator label)
  (_qvr-qiec-bind
    (_qvr-qiec-as-computation computation)
    (lambda (value) (_qvr-qiec-pure (_qvr-qiec-validate validator value label)))))
(define (_qvr-qiec-capture locals attachment-ids attachments)
  (append
    (map (lambda (entry)
           (let ((binding (cdr entry)))
             (list (cons "kind" "local")
                   (cons "label" (car entry))
                   (cons "binding" binding)
                   (cons "seed"
                         (and (_qvr-qiec-binding? binding)
                              (vector (_qvr-qiec-value binding)))))))
         locals)
    (map (lambda (attachment)
           (let ((entry (assoc attachment attachments)))
             (if (not entry) (error 'qiec "missing QIEC attachment" attachment))
             (let ((binding (cdr entry)))
               (list (cons "kind" "attachment")
                     (cons "label" attachment)
                     (cons "binding" binding)
                     (cons "seed"
                           (and (_qvr-qiec-binding? binding)
                                (vector (_qvr-qiec-value binding))))))))
         attachment-ids)))
(define (_qvr-qiec-duplicable? value)
  (cond
    ((_qvr-qiec-binding? value) (eq? (_qvr-qiec-get value "duplicable" #f) #t))
    ((or (null? value) (boolean? value) (number? value) (string? value)) #t)
    ((and (pair? value) (equal? (_qvr-qiec-get value "qiec" #f) "constructor"))
     (for-all _qvr-qiec-duplicable? (_qvr-qiec-get value "fields" '())))
    ((and (pair? value) (equal? (_qvr-qiec-get value "qiec" #f) "evidence")) #t)
    ((and (pair? value) (equal? (_qvr-qiec-get value "qiec" #f) "tuple"))
     (for-all _qvr-qiec-duplicable? (_qvr-qiec-get value "items" '())))
    (else #f)))
(define (_qvr-qiec-validate-capture request current-handler)
  (for-each
    (lambda (capture)
      (let ((binding (_qvr-qiec-get capture "binding"))
            (label (_qvr-qiec-get capture "label")))
        (if (not (_qvr-qiec-duplicable? binding))
            (error 'qiec "QIEC unrestricted resumption captures nonduplicable value" label))
        (if (and (_qvr-qiec-binding? binding)
                 (_qvr-qiec-get binding "mutable" #f)
                 (not (procedure? (_qvr-qiec-get binding "fork" #f))))
            (error 'qiec "QIEC mutable duplicable binding requires fork" label))))
    (_qvr-qiec-get request "captures" '()))
