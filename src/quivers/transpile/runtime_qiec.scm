        (error 'qiec "QIEC runtime handler definition disagrees with checked IR"))
    (if (not (_qvr-qiec-same-members? structural executable))
        (error 'qiec "QIEC runtime handler clauses disagree with checked IR"))
    (if (and (procedure? (_qvr-qiec-get handler "fork_context" #f))
             (not (_qvr-qiec-get handler "duplicable_context" #f)))
        (error 'qiec "QIEC handler fork_context requires duplicable_context"))
    (if (and (_qvr-qiec-get handler "mutable_context" #f)
             (_qvr-qiec-get handler "duplicable_context" #f)
             (not (procedure? (_qvr-qiec-get handler "fork_context" #f))))
        (error 'qiec "QIEC mutable duplicable handler requires fork_context"))))
(define (_qvr-qiec-lifecycle handler)
  (list (cons "handler" handler) (cons "finalized" (vector #f))))
(define (_qvr-qiec-lifecycle-exit lifecycle)
