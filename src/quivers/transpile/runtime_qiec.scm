    (lambda (controller)
      ((_qvr-qiec-get controller "snapshot"))
      (let ((handler ((_qvr-qiec-get controller "get"))))
        (if (not (_qvr-qiec-get handler "duplicable_context" #f))
            (error 'qiec "QIEC unrestricted resumption captures nonduplicable handler context"))
        (if (and (_qvr-qiec-get handler "mutable_context" #f)
                 (not (procedure? (_qvr-qiec-get handler "fork_context" #f))))
            (error 'qiec "QIEC mutable duplicable handler context requires fork_context"))))
    (_qvr-qiec-unique
      (append (_qvr-qiec-get request "handler_captures" '())
              (list current-handler)))))
(define (_qvr-qiec-fork-capture request current-handler shot)
  (begin
        (for-each
          (lambda (capture)
            (let* ((binding (_qvr-qiec-get capture "binding"))
                   (fork (_qvr-qiec-get binding "fork" #f)))
              (if (and (_qvr-qiec-binding? binding) (procedure? fork))
                  (let ((cell (_qvr-qiec-get binding "cell"))
                        (seed (_qvr-qiec-get capture "seed")))
                    (vector-set! cell 0 (fork (vector-ref seed 0)))))))
          (_qvr-qiec-get request "captures" '()))
        (for-each
          (lambda (controller)
            ((_qvr-qiec-get controller "install_fork")))
          (_qvr-qiec-unique
            (append (_qvr-qiec-get request "handler_captures" '())
                    (list current-handler))))))
(define (_qvr-qiec-readdress computation shot)
  (set! computation (_qvr-qiec-force computation))
  (if (eq? (car computation) 'pure)
      computation
      (let* ((request (cadr computation))
             (address (_qvr-qiec-get request "address"))
             (updated (list (car address) (cadr address) (append (caddr address) (list shot))))
             (new-request (_qvr-qiec-set request "address" updated)))
        (list 'effect new-request
              (lambda (value) (_qvr-qiec-readdress ((caddr computation) value) shot))))))
(define (_qvr-qiec-same-members? left right)
  (and (= (length left) (length right))
       (for-all (lambda (item) (member item right)) left)))
(define (_qvr-qiec-validate-handler handler manifest)
