        (_qvr-qiec-tuple (map (lambda (item) (_qvr-qiec-rowwise operator item)) row))
        (let ((row (map exact->inexact row)))
          (_qvr-qiec-tuple
            (cond
              ((string=? operator "softmax")
               (let* ((peak (apply max row))
                      (weights (map (lambda (item) (exp (- item peak))) row))
                      (total (apply + weights)))
                 (map (lambda (weight) (/ weight total)) weights)))
              ((string=? operator "log_softmax")
               (let* ((peak (apply max row))
